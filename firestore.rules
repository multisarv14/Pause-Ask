rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Shape of users/{uid}. Only these fields, with these types.
    function isValidUser(d) {
      return d.keys().hasOnly(['name', 'phone', 'roles', 'language', 'largeText',
                               'consentVersion', 'consentAcceptedAt', 'fcmToken',
                               'createdAt', 'checkin'])
        && d.keys().hasAll(['name', 'phone', 'roles', 'language', 'largeText',
                            'consentVersion', 'consentAcceptedAt', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 50
        && d.phone is string
        && d.roles is list && d.roles.size() >= 1 && d.roles.size() <= 2
        && d.roles.hasOnly(['protected', 'guardian'])
        && d.language in ['en', 'hi', 'mr']
        && d.largeText is bool
        && d.consentVersion is int && d.consentVersion >= 1
        && d.consentAcceptedAt is timestamp
        && (!('fcmToken' in d) || d.fcmToken == null
            || (d.fcmToken is string && d.fcmToken.size() <= 4096))
        && d.createdAt is timestamp;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && isValidUser(request.resource.data)
        && request.resource.data.phone == request.auth.token.phone_number
        && request.resource.data.createdAt == request.time
        && !('checkin' in request.resource.data);

      // phone and createdAt can never change. `checkin` (settings, last
      // check-in, missed alerts) and `roles` are written only by Cloud
      // Functions. Account deletion: deleteMyAccount.
      allow update: if isOwner(uid)
        && isValidUser(request.resource.data)
        && request.resource.data.phone == resource.data.phone
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('checkin', null) == resource.data.get('checkin', null)
        // Roles change only through updateRoles (keeps the circle copy in sync).
        && request.resource.data.roles == resource.data.roles;

      allow delete: if false;
    }

    // Circles: members can read; all writes go through Cloud Functions
    // (Admin SDK bypasses these rules). The client finds its circle with
    // where('memberUids', arrayContains: uid), which this rule allows.
    match /circles/{circleId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberUids;
      allow write: if false;

      match /members/{memberUid} {
        allow read: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/circles/$(circleId)).data.memberUids;
        allow write: if false;
      }
    }

    // Checks: the asker and current members of the check's circle can read
    // (guardians list them with where('circleId', '==', id)). Only Cloud
    // Functions write: analyzeCheck creates, respondToCheck sets
    // guardianResponse, onCheckCreated sets alert.
    match /checks/{checkId} {
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid
        || (resource.data.circleId != null
            && request.auth.uid in
               get(/databases/$(database)/documents/circles/$(resource.data.circleId)).data.memberUids)
      );
      allow write: if false;
    }

    // Scam alert feed: any signed-in user can read; items are added from the
    // Firebase console or the seed script (Admin SDK), never from the app.
    match /scamFeed/{itemId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // invites, memberships, joinAttempts, usage, sosUsage, _pushLog: functions only
    // (denied below).

    // Everything else stays locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
