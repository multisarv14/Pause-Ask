# Widget Preview related
.widget_preview/

# ── PauseAsk: secrets & Firebase config (never commit) ──
# google-services.json is excluded by default; commit it only if the team decides to.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
ios/firebase_app_id_file.json
lib/firebase_options.dart
.env
.env.*
# Non-secret Cloud Functions params (no API keys in these):
!functions/.env
!functions/.env.demo-pauseask
functions/.secret.local
*.keystore
*.jks
android/key.properties
service-account*.json
*-firebase-adminsdk-*.json

